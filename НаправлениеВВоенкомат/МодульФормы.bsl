Перем НазваниеМакета;

&НаСервере
Функция Просклонять(ИсходнаяСтрока, Падеж, ЭтоФИО, Пол = Неопределено)
	
	Если ЭтоФИО Тогда
		Возврат СклонениеПредставленийОбъектов.ПросклонятьФИО(ИсходнаяСтрока, Падеж, , Пол);
	Иначе
		Возврат СклонениеПредставленийОбъектов.ПросклонятьПредставление(ИсходнаяСтрока, Падеж);
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьИмяТекущейБазы()
	
	ИмяБазы = "";
	ЧастиСтрокиСоединения = СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";");
	
	Для Каждого ЧастьСтроки Из ЧастиСтрокиСоединения Цикл
		Если Лев(ЧастьСтроки, 4) = "Ref=" Тогда
			ИмяБазы = СтрЗаменить(Сред(ЧастьСтроки, 5), """", "");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИмяБазы;
	
КонецФункции

&НаСервере
Функция ДобавитьРабочиеДни(ДатаНачала, КоличествоДней)
	
	Результат = ДатаНачала;
	Осталось = КоличествоДней;
	
	Пока Осталось > 0 Цикл
		Результат = Результат + 86400; // +1 день
		ДеньНедели = ДеньНедели(Результат);
		// 6 = суббота, 7 = воскресенье
		Если ДеньНедели <> 6 И ДеньНедели <> 7 Тогда
			Осталось = Осталось - 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьФайлWordССервера()
	
	НазваниеМакета = "Направление в военкомат";
	
	Сервер = "onec";
	Порт = 8088;
	АдресРесурса = "/UT_CENTR/hs/WebServiceTest/GetMeket";
	
	Попытка
		
		НазваниеБазы = ПолучитьИмяТекущейБазы();
		Если ПустаяСтрока(НазваниеБазы) Тогда
			ВызватьИсключение "Не удалось определить имя информационной базы.";
		КонецЕсли;
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("MaketType", НазваниеМакета);
		СтруктураЗапроса.Вставить("FillVariant", "1");
		СтруктураЗапроса.Вставить("Base", НазваниеБазы);
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
		JSONТело = ЗаписьJSON.Закрыть();
		
		Соединение = Новый HTTPСоединение(Сервер, Порт);
		HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
		HTTPЗапрос.УстановитьТелоИзСтроки(JSONТело, КодировкаТекста.UTF8);
		
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			ВызватьИсключение
				"Ошибка получения макета. HTTP-код: "
				+ Строка(HTTPОтвет.КодСостояния)
				+ Символы.ПС
				+ HTTPОтвет.ПолучитьТелоКакСтроку();
		КонецЕсли;
		
		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ДанныеОтвета = Неопределено
			Или Не ДанныеОтвета.Свойство("ФайлBase64")
			Или Не ДанныеОтвета.Свойство("РезультатЗапроса") Тогда
			ВызватьИсключение "Некорректный ответ HTTP-сервиса макета.";
		КонецЕсли;
		
		ДвоичныеДанныеФайла = Base64Значение(ДанныеОтвета.ФайлBase64);
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			ВызватьИсключение "Не удалось преобразовать Word-файл из Base64.";
		КонецЕсли;
		
		Возврат Новый Структура(
			"ДвоичныеДанныеВорд,СтруктураЗаполненияВорд",
			ДвоичныеДанныеФайла,
			ДанныеОтвета.РезультатЗапроса);
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось получить макет Word:" + Символы.ПС + ОписаниеОшибки();
		Сообщение.Сообщить();
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура Печать(ИдентификаторКоманды, МассивОбъектов) Экспорт
	
	ДиалогСохранения = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогСохранения.ПолноеИмяФайла = "Направление в военкомат";
	ДиалогСохранения.Фильтр = "Направление в военкомат (*.docx)|*.docx|Документ Word (*.doc)|*.doc";
	ДиалогСохранения.МножественныйВыбор = Ложь;
	ДиалогСохранения.Заголовок = "Укажите имя сохраняемого файла";
	
	Если Не ДиалогСохранения.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	БазовоеИмяФайла = ДиалогСохранения.ПолноеИмяФайла;
	
	ДанныеМакета = ПолучитьФайлWordССервера();
	Если ДанныеМакета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоСохраненныхФайлов = 0;
	
	Для Каждого Документ Из МассивОбъектов Цикл
		
		// Поддерживаются: ПриемНаРаботу и ПриемНаРаботуСписком
		МассивДанныхЗаполнения = ПолучитьДанныеЗаполненияПоДокументу(Документ);
		
		Для Каждого СтруктураЗаполнения Из МассивДанныхЗаполнения Цикл
			
			АдресНаСервере = "";
			СоздатьФайлНаСервереНовый(ДанныеМакета, АдресНаСервере, СтруктураЗаполнения);
			
			Если ПустаяСтрока(АдресНаСервере) Тогда
				Продолжить;
			КонецЕсли;
			
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресНаСервере);
			Если ДвоичныеДанные = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяСотрудника = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтруктураЗаполнения.ФИОНоминатив, "/", "_"), "\", "_"), ":", "_");
			ПолноеИмяФайла = БазовоеИмяФайла + " " + ИмяСотрудника + ".docx";
			
			ДвоичныеДанные.Записать(ПолноеИмяФайла);
			КоличествоСохраненныхФайлов = КоличествоСохраненныхФайлов + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Сохранено файлов: " + Строка(КоличествоСохраненныхФайлов);
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеЗаполненияПоДокументу(ДокументСсылка)
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокиСотрудников = ПолучитьСтрокиСотрудниковДокумента(ДокументСсылка);
	
	Если СтрокиСотрудников.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В документе " + Строка(ДокументСсылка)
			+ " не найдены сотрудники для печати направления.";
		Сообщение.Сообщить();
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаСотрудника Из СтрокиСотрудников Цикл
		
		СтруктураЗаполнения = СформироватьДанныеЗаполненияБланка(
			СтрокаСотрудника.ФизическоеЛицо,
			СтрокаСотрудника.ДатаДокумента);
		
		Если СтруктураЗаполнения <> Неопределено Тогда
			Результат.Добавить(СтруктураЗаполнения);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьСтрокиСотрудниковДокумента(ДокументСсылка)
	
	Результат = Новый Массив;
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.ПриемНаРаботу") Тогда
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ДокументСсылка,
			"Сотрудник, ФизическоеЛицо, Дата");
		
		ФизическоеЛицо = РеквизитыДокумента.ФизическоеЛицо;
		Если Не ЗначениеЗаполнено(ФизическоеЛицо)
			И ЗначениеЗаполнено(РеквизитыДокумента.Сотрудник) Тогда
			
			ФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				РеквизитыДокумента.Сотрудник,
				"ФизическоеЛицо");
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФизическоеЛицо) Тогда
			Результат.Добавить(Новый Структура(
				"Сотрудник,ФизическоеЛицо,ДатаДокумента",
				РеквизитыДокумента.Сотрудник,
				ФизическоеЛицо,
				РеквизитыДокумента.Дата));
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПриемНаРаботуСписком") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Сотрудники.Сотрудник КАК Сотрудник,
			|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
			|	Сотрудники.Ссылка.Дата КАК ДатаДокумента
			|ИЗ
			|	Документ.ПриемНаРаботуСписком.Сотрудники КАК Сотрудники
			|ГДЕ
			|	Сотрудники.Ссылка = &Ссылка
			|
			|УПОРЯДОЧИТЬ ПО
			|	Сотрудники.НомерСтроки";
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ФизическоеЛицо = Выборка.ФизическоеЛицо;
			Если Не ЗначениеЗаполнено(ФизическоеЛицо)
				И ЗначениеЗаполнено(Выборка.Сотрудник) Тогда
				
				ФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
					Выборка.Сотрудник,
					"ФизическоеЛицо");
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
				Продолжить;
			КонецЕсли;
			
			Результат.Добавить(Новый Структура(
				"Сотрудник,ФизическоеЛицо,ДатаДокумента",
				Выборка.Сотрудник,
				ФизическоеЛицо,
				Выборка.ДатаДокумента));
			
		КонецЦикла;
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Документ " + Строка(ДокументСсылка)
			+ " не поддерживается. Ожидается ПриемНаРаботу или ПриемНаРаботуСписком.";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СформироватьДанныеЗаполненияБланка(ФизическоеЛицо, ДатаДокумента)
	
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ДанныеФизлица = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ФизическоеЛицо,
		"Наименование, Фамилия, Имя, Отчество, Пол");
	
	ФИОНоминатив = СокрЛП(ДанныеФизлица.Наименование);
	Если ПустаяСтрока(ФИОНоминатив) Тогда
		ФИОНоминатив = СокрЛП(
			Строка(ДанныеФизлица.Фамилия) + " "
			+ Строка(ДанныеФизлица.Имя) + " "
			+ Строка(ДанныеФизлица.Отчество));
	КонецЕсли;
	
	// В шапке письма — дательный падеж
	ФИОДательный = Просклонять(ФИОНоминатив, 3, Истина, ДанныеФизлица.Пол);
	Если ПустаяСтрока(ФИОДательный) Тогда
		ФИОДательный = ФИОНоминатив;
	КонецЕсли;
	
	// Для подписи ознакомления — сокращённое ФИО с инициалами
	ФИОИнициалы = ФизическиеЛицаЗарплатаКадрыКлиентСервер.ФамилияИнициалы(ФИОНоминатив);
	Если ПустаяСтрока(ФИОИнициалы) Тогда
		ФИОИнициалы = СформироватьФамилиюИнициалы(
			ДанныеФизлица.Фамилия,
			ДанныеФизлица.Имя,
			ДанныеФизлица.Отчество);
	КонецЕсли;
	
	АдресВоенкомата = ПолучитьАдресВоенкомата(ФизическоеЛицо);
	ДатаСрок = ДобавитьРабочиеДни(ДатаДокумента, 3);
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("ФИОДательный", ФИОДательный);
	СтруктураЗаполнения.Вставить("ФИОНоминатив", ФИОНоминатив);
	СтруктураЗаполнения.Вставить("ФИОИнициалы", ФИОИнициалы);
	СтруктураЗаполнения.Вставить("АдресВоенкомата", АдресВоенкомата);
	СтруктураЗаполнения.Вставить("ДатаДокумента", Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"));
	СтруктураЗаполнения.Вставить("ДатаСрокЯвки", Формат(ДатаСрок, "ДФ=dd.MM.yyyy"));
	
	Возврат СтруктураЗаполнения;
	
КонецФункции

&НаСервере
Функция СформироватьФамилиюИнициалы(Фамилия, Имя, Отчество)
	
	Результат = СокрЛП(Строка(Фамилия));
	
	ИмяСтрока = СокрЛП(Строка(Имя));
	Если Не ПустаяСтрока(ИмяСтрока) Тогда
		Результат = Результат + " " + ВРег(Лев(ИмяСтрока, 1)) + ".";
	КонецЕсли;
	
	ОтчествоСтрока = СокрЛП(Строка(Отчество));
	Если Не ПустаяСтрока(ОтчествоСтрока) Тогда
		Результат = Результат + ВРег(Лев(ОтчествоСтрока, 1)) + ".";
	КонецЕсли;
	
	Возврат СокрЛП(Результат);
	
КонецФункции

&НаСервере
Функция ПолучитьАдресВоенкомата(ФизическоеЛицо)
	
	АдресВоенкомата = "";
	Военкомат = Неопределено;
	
	// 1) Воинский учет физического лица
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ВоинскийУчет.Военкомат КАК Военкомат
			|ИЗ
			|	РегистрСведений.ВоинскийУчет.СрезПоследних(, ФизическоеЛицо = &ФизическоеЛицо) КАК ВоинскийУчет
			|ГДЕ
			|	ВоинскийУчет.ФизическоеЛицо = &ФизическоеЛицо";
		Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Военкомат = Выборка.Военкомат;
		КонецЕсли;
	Исключение
		// В части конфигураций регистр может называться иначе — ниже запасной путь
	КонецПопытки;
	
	// 2) Запасной путь: кадровые данные
	Если Не ЗначениеЗаполнено(Военкомат) Тогда
		Попытка
			МассивФизлиц = Новый Массив;
			МассивФизлиц.Добавить(ФизическоеЛицо);
			КадровыеДанные = КадровыйУчет.КадровыеДанныеФизическихЛиц(
				Истина,
				МассивФизлиц,
				"Военкомат",
				ТекущаяДатаСеанса());
			Если КадровыеДанные <> Неопределено И КадровыеДанные.Количество() > 0 Тогда
				Военкомат = КадровыеДанные[0].Военкомат;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Военкомат) Тогда
		Возврат "";
	КонецЕсли;
	
	// Адрес из контактной информации военкомата
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	КИ.Представление КАК Представление
			|ИЗ
			|	Справочник.Военкоматы.КонтактнаяИнформация КАК КИ
			|ГДЕ
			|	КИ.Ссылка = &Военкомат
			|	И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
			|
			|УПОРЯДОЧИТЬ ПО
			|	КИ.НомерСтроки";
		Запрос.УстановитьПараметр("Военкомат", Военкомат);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			АдресВоенкомата = СокрЛП(Выборка.Представление);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Если ПустаяСтрока(АдресВоенкомата) Тогда
		АдресВоенкомата = СокрЛП(Строка(Военкомат));
	КонецЕсли;
	
	Возврат АдресВоенкомата;
	
КонецФункции

&НаСервере
Процедура СоздатьФайлНаСервереНовый(ДанныеМакета, АдресНаСервере, СтруктураЗаполнения)
	
	АдресНаСервере = "";
	Word = Неопределено;
	ДокументWord = Неопределено;
	ИмяФайлаМакета = "";
	ИмяРезультирующегоФайла = "";
	
	Если ДанныеМакета = Неопределено Тогда
		ВызватьИсключение "Не получен макет Word.";
	КонецЕсли;
	
	Если СтруктураЗаполнения = Неопределено Тогда
		ВызватьИсключение "Не переданы данные заполнения.";
	КонецЕсли;
	
	ИмяФайлаМакета = ПолучитьИмяВременногоФайла("docx");
	ДанныеМакета.ДвоичныеДанныеВорд.Записать(ИмяФайлаМакета);
	ТаблицаРеквизитов = ДанныеМакета.СтруктураЗаполненияВорд;
	
	Попытка
		
		Word = Новый COMОбъект("Word.Application");
		Word.Visible = 0;
		Word.Application.DisplayAlerts = Ложь;
		
		Word.Documents.Open(ИмяФайлаМакета);
		ДокументWord = Word.ActiveDocument;
		
		// Закладки из макета "Направление в военкомат"
		СтруктураВсехЗакладок = Новый Структура;
		СтруктураВсехЗакладок.Вставить("v8_ФИО", СтруктураЗаполнения.ФИОДательный);
		СтруктураВсехЗакладок.Вставить("v8_адрес_военкомата", СтруктураЗаполнения.АдресВоенкомата);
		СтруктураВсехЗакладок.Вставить("v8_тек_дата_плюс_тридня_рабочих", СтруктураЗаполнения.ДатаСрокЯвки);
		СтруктураВсехЗакладок.Вставить("v8_тек_дата", СтруктураЗаполнения.ДатаДокумента);
		СтруктураВсехЗакладок.Вставить("v8_ФИО2", СтруктураЗаполнения.ФИОИнициалы);
		
		МассивЗакладок = Новый Массив;
		Для Каждого КлючЗначение Из СтруктураВсехЗакладок Цикл
			Если ДокументWord.Bookmarks.Exists(КлючЗначение.Ключ) Тогда
				МассивЗакладок.Добавить(Новый Структура(
					"ИмяЗакладки,Значение",
					КлючЗначение.Ключ,
					КлючЗначение.Значение));
			КонецЕсли;
		КонецЦикла;
		
		// Сначала значения из таблицы HTTP-сервиса (если есть)
		Если ТаблицаРеквизитов <> Неопределено Тогда
			Для Каждого Элемент Из ТаблицаРеквизитов Цикл
				
				ИмяЗакладки = "";
				ЗначениеЗакладки = "";
				
				Если Не Элемент.Свойство("РеквизитЗаполнения", ИмяЗакладки) Тогда
					Продолжить;
				КонецЕсли;
				
				Элемент.Свойство("ЗначениеЗаполнение", ЗначениеЗакладки);
				
				Если Не ДокументWord.Bookmarks.Exists(ИмяЗакладки) Тогда
					Продолжить;
				КонецЕсли;
				
				ДокументWord.Bookmarks(ИмяЗакладки).Select();
				ДокументWord.Application.Selection.TypeText(Строка(ЗначениеЗакладки));
				
				ИндексДляУдаления = Неопределено;
				Для Индекс = 0 По МассивЗакладок.Количество() - 1 Цикл
					Если МассивЗакладок[Индекс].ИмяЗакладки = ИмяЗакладки Тогда
						ИндексДляУдаления = Индекс;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если ИндексДляУдаления <> Неопределено Тогда
					МассивЗакладок.Удалить(ИндексДляУдаления);
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		// Затем локальные закладки, которые ещё не заполнены
		Для Каждого СтруктураЗакладки Из МассивЗакладок Цикл
			Если ДокументWord.Bookmarks.Exists(СтруктураЗакладки.ИмяЗакладки) Тогда
				ДокументWord.Bookmarks(СтруктураЗакладки.ИмяЗакладки).Select();
				ДокументWord.Application.Selection.TypeText(Строка(СтруктураЗакладки.Значение));
			КонецЕсли;
		КонецЦикла;
		
		ИмяРезультирующегоФайла = ПолучитьИмяВременногоФайла("docx");
		ДокументWord.SaveAs(ИмяРезультирующегоФайла);
		
		ДокументWord.Close();
		ДокументWord = Неопределено;
		
		Word.Quit(0);
		Word = Неопределено;
		
		ДвоичныеДанныеРезультата = Новый ДвоичныеДанные(ИмяРезультирующегоФайла);
		АдресНаСервере = ПоместитьВоВременноеХранилище(ДвоичныеДанныеРезультата);
		
	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		
		Если ДокументWord <> Неопределено Тогда
			Попытка
				ДокументWord.Close(Ложь);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Если Word <> Неопределено Тогда
			Попытка
				Word.Quit(0);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		ВызватьИсключение "Ошибка формирования Word-файла:" + Символы.ПС + ТекстОшибки;
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Команда1(Команда)
	
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(ДокументПриема);
	Печать("НаправлениеВВоенкомат", МассивДокументов);
	
КонецПроцедуры
